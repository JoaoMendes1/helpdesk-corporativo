# Nomes das variáveis que o projeto usa, nunca os valores reais.
# O docker compose up funciona sem .env: o docker-compose.yml traz valores de
# desenvolvimento. Para trocar algum, copie este arquivo para .env e preencha.
# A lista é fechada junto com o docker-compose.yml, na etapa 2 do docs/ROADMAP.md.

# Conexão do backend com o MySQL, no formato que o Prisma lê.
DATABASE_URL=

# Segredo que assina o token de login. Fora do desenvolvimento, um valor longo e aleatório.
JWT_SECRET=

# Porta em que o backend sobe dentro do container.
PORT=