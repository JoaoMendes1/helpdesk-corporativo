# Nomes das variáveis que o projeto usa, sem valores reais
# O docker compose up funciona sem .env: o docker-compose.yml traz valores de desenvolvimento
# fictícios. Para trocar algum, copiar este arquivo para .env e preencher só o que precisar trocar.
# Variável deixada vazia usa o valor de desenvolvimento.

# Porta do frontend na sua máquina. Padrão: 8080.
FRONTEND_PORT=

# Banco MySQL. A senha vai dentro da URL de conexão do backend: use só letras, números e "_".
# Só valem no primeiro up: com o banco já criado, a troca é ignorada e o backend recebe
# "Access denied". Para aplicar, docker compose down -v (apaga o banco; o seed roda de novo).
# Só valem no primeiro up: com o banco já criado, a troca é ignorada e o backend recebe
# "Access denied". Para aplicar, docker compose down -v (apaga o banco; o seed roda de novo).
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=